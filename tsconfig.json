{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "types": [
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@ac/shared": ["vendor/asheron-web/packages/shared/src/index.ts"],
      "@ac/shared/*": ["vendor/asheron-web/packages/shared/src/*"],
      "@ac/dat-parser": ["vendor/asheron-web/packages/dat-parser/src/index.ts"],
      "@ac/dat-parser/*": ["vendor/asheron-web/packages/dat-parser/src/*"],
      "@ac/renderer": ["vendor/asheron-web/packages/renderer/src/index.ts"],
      "@ac/renderer/*": ["vendor/asheron-web/packages/renderer/src/*"]
    }
  },
  "include": [
    "tools/**/*.ts",
    "src/**/*.ts",
    "tests/**/*.ts",
    "*.ts"
  ]
}